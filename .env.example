# GEMINI_API_KEY: Optional, for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Port (server.ts reads APP_PORT, Vite uses PORT)
APP_PORT=3000
PORT=3000

# Database (optional if using the local JSON store in /data)
DATABASE_URL="mysql://root:password@localhost:3306/automation_agent"

# Credential pointers for a registered app (names must match the env vars you enter when registering)
APP_USERNAME="your-username"
APP_PASSWORD="your-password"

# Local AI Engine (optional)
OLLAMA_BASE_URL="http://localhost:11434"
