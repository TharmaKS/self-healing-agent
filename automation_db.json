      "id": "cap-filter-claims",
      "applicationId": "app-claims-portal",
      "businessName": "Filter Claims by Payer and Status",
      "type": "TABLE_OPERATION",
      "pageContext": "Claims Ledger",
      "semanticDescription": "Filter active claims table by payer (e.g. Medicare Part A) and status (e.g. Ready)",
      "targetDefinition": {
        "semanticIntent": "Filter claims table rows",
        "controlType": "table_filter",
        "pageContext": "Claims"
      },
      "inputDefinition": [
        {
          "name": "payer",
          "type": "STRING",
          "required": true,
          "defaultValue": "Medicare Part A"
        },
        {
          "name": "status",
          "type": "STRING",
          "required": true,
          "defaultValue": "Ready"
        }
      ],
      "outputDefinition": [
        {
          "name": "matchedRowCount",
          "type": "NUMBER"
        },
        {
          "name": "matchedRowIds",
          "type": "OBJECT"
        }
      ],
      "verificationDefinition": {
        "expectedOutcome": "Table view filtered to matching claims",
        "successCondition": {
          "statusText": "Filtered"
        }
      },
      "recoveryDefinition": {
        "allowHumanRemapping": false,
        "maxRetries": 1,
        "onFailure": "CONTINUE"
      },
      "riskLevel": "LOW",
      "version": 1,
      "isPublished": true,
      "createdAt": "2026-09-25T17:26:33.742Z",
      "updatedAt": "2026-09-25T17:26:33.742Z"
    },
    {
      "id": "cap-process-claims",
      "applicationId": "app-claims-portal",
      "businessName": "Process Matched Claims",
      "type": "TABLE_OPERATION",
      "pageContext": "Claims Ledger",
      "semanticDescription": "Iterate each matched row, execute row-level action (Send Claim), handle remappings and verify outcome",
      "targetDefinition": {
        "semanticIntent": "Send Claim",
        "visibleTextPattern": "Send Claim|Submit",
        "role": "button",
        "controlType": "row_action",
        "isRowAction": true
      },
      "inputDefinition": [
        {
          "name": "expectedAction",
          "type": "STRING",
          "required": true,
          "defaultValue": "Send Claim"
        }
      ],
      "outputDefinition": [
        {
          "name": "processedCount",
          "type": "NUMBER"
        },
        {
          "name": "successCount",
          "type": "NUMBER"
        },
        {
          "name": "failedCount",
          "type": "NUMBER"
        }
      ],
      "verificationDefinition": {
        "expectedOutcome": "Claim status transitions to Sent with verified submission reference (e.g. SUB-100x)",
        "successCondition": {
          "statusText": "Sent",
          "requiresReferenceNumber": true,
          "referencePattern": "SUB-\\d+",
          "prohibitedErrors": [
            "Validation error",
            "Failed to dispatch"
          ]
        }
      },
      "recoveryDefinition": {
        "allowHumanRemapping": true,
        "maxRetries": 2,
        "fallbackCandidates": [
          "Submit",
          "Process",
          "Dispatch"
        ],
        "onFailure": "CONTINUE"
      },
      "riskLevel": "HIGH",
      "version": 1,
      "isPublished": true,
      "createdAt": "2026-09-25T17:26:33.742Z",
      "updatedAt": "2026-09-25T17:26:33.742Z"
    },
