  "flows": [
    {
      "id": "flow-medicare-batch",
      "applicationId": "app-claims-portal",
      "name": "Medicare Part A Claims Batch Processing",
      "description": "End-to-end intent-driven flow: Login -> Open Claims -> Filter Medicare Part A (Ready) -> Process Matched Rows with outcome verification and human remapping -> Export CSV Report",
      "status": "PRODUCTION",
      "version": 1,
      "latestTestStatus": "SUCCESS",
      "failurePolicy": "CONTINUE",
      "variables": [
        {
          "name": "PAYER_TARGET",
          "type": "STRING",
          "source": "FLOW_VARIABLE",
          "value": "Medicare Part A"
        },
        {
          "name": "STATUS_TARGET",
          "type": "STRING",
          "source": "FLOW_VARIABLE",
          "value": "Ready"
        }
      ],
      "nodes": [
        {
          "id": "node-start",
          "type": "START",
          "position": {
            "x": 50,
            "y": 150
          },
          "data": {
            "label": "Start Flow",
            "description": "Execution begins"
          }
        },
        {
          "id": "node-login",
          "type": "CAPABILITY",
          "position": {
            "x": 260,
            "y": 150
          },
          "data": {
            "label": "Login Claims Portal",
            "capabilityId": "cap-login",
            "description": "Authenticate session with CLAIMS_USERNAME & CLAIMS_PASSWORD"
          }
        },
        {
          "id": "node-open-claims",
          "type": "CAPABILITY",
          "position": {
            "x": 500,
            "y": 150
          },
          "data": {
            "label": "Open Claims Ledger",
            "capabilityId": "cap-open-claims",
            "description": "Navigate to active claims ledger"
          }
        },
        {
          "id": "node-filter-claims",
          "type": "TABLE_PROCESS",
          "position": {
            "x": 740,
            "y": 150
          },
          "data": {
            "label": "Filter Medicare Part A",
            "capabilityId": "cap-filter-claims",
            "description": "Filter Payer = Medicare Part A & Status = Ready",
            "filterConfig": {
              "table": "Claims",
              "conditions": [
                {
                  "column": "Payer",
                  "operator": "EQUALS",
                  "value": "Medicare Part A"
                },
                {
                  "column": "Status",
                  "operator": "EQUALS",
                  "value": "Ready"
                }
              ]
            }
          }
        },
        {
          "id": "node-process-claims",
          "type": "TABLE_PROCESS",
          "position": {
            "x": 990,
            "y": 150
          },
          "data": {
            "label": "Process Matched Claims",
            "capabilityId": "cap-process-claims",
            "description": "Execute row-level Send Claim with outcome verification and human remapping",
            "rowActionCapabilityId": "cap-process-claims",
            "failurePolicy": "CONTINUE"
          }
        },
        {
          "id": "node-extract-report",
          "type": "CAPABILITY",
          "position": {
            "x": 1240,
            "y": 150
          },
          "data": {
            "label": "Generate Batch CSV",
            "capabilityId": "cap-extract-confirmations",
            "description": "Compile verified outcomes into audit-ready CSV report"
          }
        },
        {
          "id": "node-end",
          "type": "END",
          "position": {
            "x": 1480,
            "y": 150
          },
          "data": {
            "label": "End Flow",
            "description": "Audit report produced"
          }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "node-start",
          "target": "node-login"
        },
        {
          "id": "e2",
          "source": "node-login",
          "target": "node-open-claims"
        },
        {
          "id": "e3",
          "source": "node-open-claims",
          "target": "node-filter-claims"
        },
        {
          "id": "e4",
          "source": "node-filter-claims",
          "target": "node-process-claims"
        },
        {
          "id": "e5",
          "source": "node-process-claims",
          "target": "node-extract-report"
        },
        {
          "id": "e6",
          "source": "node-extract-report",
          "target": "node-end"
        }
      ],
      "createdAt": "2026-09-25T17:26:33.742Z",
      "updatedAt": "2026-09-25T17:27:15.261Z"
    }
