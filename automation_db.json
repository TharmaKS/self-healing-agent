      "semanticDescription": "Authenticate into the Claims Portal using configured environment credentials",
      "targetDefinition": {
        "semanticIntent": "Login credentials and submit",
        "visibleTextPattern": "Sign In|Log In",
        "role": "button",
        "controlType": "form",
        "selectorFallback": "#login-button"
      },
      "inputDefinition": [
        {
          "name": "username",
          "type": "CREDENTIAL_REF",
          "required": true,
          "description": "Refers to CLAIMS_USERNAME"
        },
        {
          "name": "password",
          "type": "CREDENTIAL_REF",
          "required": true,
          "description": "Refers to CLAIMS_PASSWORD"
        }
      ],
      "outputDefinition": [
        {
          "name": "sessionState",
          "type": "STRING",
          "description": "AUTHENTICATED"
        }
      ],
      "verificationDefinition": {
        "expectedOutcome": "User dashboard visible and claims navigation accessible",
        "successCondition": {
          "statusText": "Dashboard",
          "prohibitedErrors": [
            "Invalid credentials",
            "Login failed"
          ]
        }
      },
      "recoveryDefinition": {
        "allowHumanRemapping": true,
        "maxRetries": 2,
        "onFailure": "STOP"
      },
      "riskLevel": "LOW",
      "version": 1,
      "isPublished": true,
